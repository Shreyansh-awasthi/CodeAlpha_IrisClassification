        "import torch\n",
        "from transformers import AutoModelForCausalLM, AutoTokenizer\n",
        "from peft import PeftModel\n",
        "\n",
        "MODEL_ID = \"Qwen/Qwen2.5-3B-Instruct\"\n",
        "ADAPTER_PATH = \"./final_lora_adapter\"\n",
        "\n",
        "print(\"Loading base model and custom trained LoRA adapters...\")\n",
        "# Load tokenizer\n",
        "tokenizer = AutoTokenizer.from_pretrained(ADAPTER_PATH)\n",
        "\n",
        "# Load the base model in 4-bit again\n",
        "model = AutoModelForCausalLM.from_pretrained(\n",
        "    MODEL_ID,\n",
        "    torch_dtype=torch.float16,\n",
        "    device_map={\"\": 0}\n",
        ")\n",
        "\n",
        "# Merge the active adapter layer right on top of the base model\n",
        "model = PeftModel.from_pretrained(model, ADAPTER_PATH)\n",
        "\n",
        "# ==========================================\n",
        "# TEST YOUR PROMPT HERE\n",
        "# ==========================================\n",
        "custom_instruction = \"Write a simple step-by-step plan to learn Python.\"\n",
        "\n",
        "formatted_prompt = f\"### Instruction:\\n{custom_instruction}\\n\\n### Response:\\n\"\n",
        "inputs = tokenizer(formatted_prompt, return_tensors=\"pt\").to(\"cuda\")\n",
        "\n",
        "print(\"\\nGenerating model response...\")\n",
        "with torch.no_grad():\n",
        "    outputs = model.generate(\n",
        "        **inputs,\n",
        "        max_new_tokens=150,\n",
        "        temperature=0.7,\n",
        "        eos_token_id=tokenizer.eos_token_id\n",
        "    )\n",
        "\n",
        "response = tokenizer.decode(outputs[0], skip_special_tokens=True)\n",
        "print(\"\\n\" + response)\n"
      ],
