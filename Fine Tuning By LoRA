        "import torch\n",
        "from transformers import AutoModelForCausalLM, AutoTokenizer\n",
        "\n",
        "from peft import LoraConfig,get_peft_model,TaskType"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "# Configure PyTorch memory management variables before loading tensors\n",
        "os.environ[\"PYTORCH_ALLOC_CONF\"] = \"expandable_segments:True\"\n",
        "\n",
        "import torch\n",
        "from datasets import load_dataset\n",
        "from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n",
        "from peft import LoraConfig, get_peft_model, TaskType\n",
        "from trl import SFTConfig, SFTTrainer\n",
        "\n",
        "# ==========================================\n",
        "# 1. CONFIGURATION\n",
        "# ==========================================\n",
        "# Scaled to 3B parameters to stay comfortably below the 14.56 GiB T4 VRAM ceiling\n",
        "MODEL_ID = \"Qwen/Qwen2.5-3B-Instruct\"\n",
        "\n",
        "bnb_config = BitsAndBytesConfig(\n",
        "    load_in_4bit=True,\n",
        "    bnb_4bit_quant_type=\"nf4\",\n",
        "    bnb_4bit_compute_dtype=torch.float16, # Optimized for T4 GPUs\n",
        "    bnb_4bit_use_double_quant=True\n",
        ")\n",
        "\n",
        "# ==========================================\n",
        "# 2. LOAD MODEL & TOKENIZER\n",
        "# ==========================================\n",
        "print(f\"Loading {MODEL_ID} straight into GPU VRAM safely...\")\n",
        "model = AutoModelForCausalLM.from_pretrained(\n",
        "    MODEL_ID,\n",
        "    quantization_config=bnb_config,\n",
        "    device_map={\"\": 0}, # Drops virtual 'meta' device errors by forcing directly onto GPU\n",
        "    low_cpu_mem_usage=True\n",
        ")\n",
        "\n",
        "tokenizer = AutoTokenizer.from_pretrained(MODEL_ID)\n",
        "tokenizer.pad_token = tokenizer.eos_token\n",
        "\n",
        "# ==========================================\n",
        "# 3. SETUP LoRA ADAPTERS\n",
        "# ==========================================\n",
        "lora_config = LoraConfig(\n",
        "    r=8,\n",
        "    lora_alpha=16,\n",
        "    target_modules=[\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\"],\n",
        "    lora_dropout=0.05,\n",
        "    bias=\"none\",\n",
        "    task_type=TaskType.CAUSAL_LM\n",
        ")\n",
        "\n",
        "model = get_peft_model(model, lora_config)\n",
        "print(\"\\n--- Trainable Parameter Architecture ---\")\n",
        "model.print_trainable_parameters()\n",
        "\n",
        "# ==========================================\n",
        "# 4. DATASET & CLEAN FORMATTING\n",
        "# ==========================================\n",
        "print(\"\\nLoading dataset...\")\n",
        "dataset = load_dataset(\"tatsu-lab/alpaca\", split=\"train[:1000]\")\n",
        "\n",
        "# Bypasses internal TRL endswith list errors by creating a clean string field column\n",
        "def format_prompts(example):\n",
        "    return {\n",
        "        \"text\": f\"### Instruction:\\n{example['instruction']}\\n\\n### Response:\\n{example['output']}{tokenizer.eos_token}\"\n",
        "    }\n",
        "\n",
        "dataset = dataset.map(format_prompts)\n",
        "\n",
        "# ==========================================\n",
        "# 5. DEFINE VRAM-CONSERVATIVE TRAINING CONFIG\n",
        "# ==========================================\n",
        "training_args = SFTConfig(\n",
        "    output_dir=\"./lora_output\",\n",
        "    per_device_train_batch_size=1,     # Aggressive batch sizing protects against runtime drops\n",
        "    gradient_accumulation_steps=4,     # Accumulates steps to fake a total batch size of 4\n",
        "    learning_rate=2e-4,\n",
        "    logging_steps=10,\n",
        "    max_steps=50,                      # Keeps the initial execution test fast\n",
        "    optim=\"paged_adamw_8bit\",          # Offloads optimizer tables to prevent memory fragmentation\n",
        "    report_to=\"none\",\n",
        "    max_length=512,                    # Hard cap on sequence context lengths\n",
        "    packing=False,\n",
        "    dataset_text_field=\"text\",         # Explicitly instructs the SFT engine where the content lives\n",
        "    gradient_checkpointing=False,      # Disables conflicting auto-wrappers that cause the 'offload' bug\n",
        "\n",
        "    # --- The Precision Alignment Fixes ---\n",
        "    fp16=False,                        # Disables Float16 scaling mathematics to avoid the AMP crash\n",
        "    bf16=True                          # Explicitly forces stable BFloat16 gradient handling\n",
        ")\n",
        "\n",
        "# Natively enable gradient checkpointing on the base model layer to save VRAM safely\n",
        "model.gradient_checkpointing_enable()\n",
        "\n",
        "# ==========================================\n",
        "# 6. RUN THE TRAINER\n",
        "# ==========================================\n",
        "trainer = SFTTrainer(\n",
        "    model=model,\n",
        "    train_dataset=dataset,\n",
        "    args=training_args\n",
        ")\n",
        "\n",
        "print(\"\\nStarting clean training loop...\")\n",
        "trainer.train()\n",
        "print(\"\\nTraining Complete!\")\n",
        "\n",
        "# ==========================================\n",
        "# 7. SAVE THE TRAINED ADAPTERS\n",
        "# ==========================================\n",
        "trainer.model.save_pretrained(\"./final_lora_adapter\")\n",
        "tokenizer.save_pretrained(\"./final_lora_adapter\")\n",
        "print(\"LoRA weights saved successfully to './final_lora_adapter'\")\n"
      ],
